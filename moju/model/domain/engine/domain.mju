// ---------------------------------------------------------------------------
// engine domain — CEP engine core
// Crate: wf-engine
// ---------------------------------------------------------------------------

// -- Actors -------------------------------------------------------------------

actor DataSender {
  can IncomingBatch
}

// -- Trigger commands --------------------------------------------------------

command IncomingBatch {
  stream_name: String
}

command MemoryPressure {
  window_name: String
}

command NewEvents {
  events: List<Event>
}

// -- Event types -------------------------------------------------------------

struct Event {
  schema: String
  fields: Map<String, Value>
  timestamp: String
}

state Value {
  Number
  Str
  Bool
  Array
  Object
}

// -- Alert / output ----------------------------------------------------------

struct OutputRecord {
  id: String
  rule_name: String
  score: Int
  entity_type: String
  entity_id: String
  origin: AlertOrigin
  close_reason: CloseReason
  fired_at: String
  emit_time: String
  fields: Map
}

state AlertOrigin {
  Event
  Close
}

state CloseReason {
  Timeout
  Flush
  Eos
}

// -- Window buffer -----------------------------------------------------------

struct Window {
  name: String
  schema: String
  over: String
  config: WindowConfig
}

struct WindowParams {
  name: String
  schema: String
  time_col_index: Int
  over: String
}

state AppendOutcome {
  Appended
  DroppedLate
}

struct TimedBatch {
  batch: String
  event_time_range: String
  ingested_at: String
  row_count: Int
  byte_size: Int
  seq: Int
}

// -- Window registry & routing ----------------------------------------------

struct WindowRegistry {
  windows: List<Window>
  provider_windows: List<ProviderWindow>
  subscriptions: Map
  notifiers: Map
}

struct WindowDef {
  params: WindowParams
  streams: List<String>
  config: WindowConfig
}

struct Router {
  registry: WindowRegistry
}

struct RouteReport {
  delivered: Int
  dropped_late: Int
  skipped_non_local: Int
  per_window: List<WindowRouteOutcome>
}

struct WindowRouteOutcome {
  window_name: String
  rows: Int
  late: Bool
}

// -- Rule execution ----------------------------------------------------------

struct RuleExecutor {
  plan: RulePlan
  yield_field_types: Map<String, FieldType>
  output: OutputConfig
}

struct CepStateMachine {
  steps: List<StepState>
  active_instances: Int
  close_mode: String
}

struct InstanceKey {
  scope_key_str: String
  bucket_start: Int?
}

struct Instance {
  step_states: List<StepState>
  scope_key: List<Value>
  machine_id: String
  last_event_nanos: Int
  current_step: Int
  event_ok: Bool
  event_emitted: Bool
  completed_steps: List<String>
  close_step_states: List<StepState>
  alias_states: Map<String, AliasState>
  baselines: Map<String, RollingStats>
  created_at: Int
}

struct StepState {
  branch_states: List<BranchState>
}

struct BranchState {
  count: Int
  sum: Float
  min: Float
  max: Float
  min_val: Value?
  max_val: Value?
  avg_sum: Float
  avg_count: Int
  distinct_set: List<ValueKey>
  event_first_time_nanos: Int?
  event_last_time_nanos: Int?
  collected_values: List<Value>
}

struct StepData {
  satisfied_branch_index: Int
  label: String?
  measure_value: Float
  event_first_time_nanos: Int?
  event_last_time_nanos: Int?
  collected_values: List<Value>
  field_values: Map<String, List<Value>>
}

state StepResult {
  Accumulate
  Advance
  Matched
}

struct StepProgress {
  rule_name: String
  scope_key: List<Value>
  machine_id: String
  step_index: Int
  step_label: String?
  branch_index: Int
  branch_source: String
  threshold_checked_branches: Int
  measure_value: Float
  cmp: String
  threshold: String
  satisfied: Bool
  instances: Int
}

struct StepOutcome {
  result: StepResult
  progress: StepProgress?
}

struct MatchedContext {
  rule_name: String
  scope_key: List<Value>
  step_data: List<StepData>
  bind_data: List<BindData>
  event_time_nanos: Int
  event_first_time_nanos: Int
  event_last_time_nanos: Int
  window_start_time_nanos: Int
  window_end_time_nanos: Int
  machine_id: String
}

struct CloseOutput {
  rule_name: String
  scope_key: List<Value>
  close_reason: CloseReason
  event_ok: Bool
  close_ok: Bool
  close_mode: CloseMode
  event_emitted: Bool
  event_step_data: List<StepData>
  close_step_data: List<StepData>
  bind_data: List<BindData>
  watermark_nanos: Int
  machine_id: String
}

struct BindData {
  alias: String
  count: Int
  field_values: Map<String, List<Value>>
}

struct RollingStats {
  count: Int
  sum: Float
  min: Float
  max: Float
  min_val: Value?
  max_val: Value?
  avg_sum: Float
}

state ValueKey {
  Number
  Str
  Bool
  Array
  Object
}

struct AliasState {
  rows: List<Event>
  field_values: Map<String, List<Value>>
}

// -- Eviction ----------------------------------------------------------------

struct EvictReport {
  windows_scanned: Int
  batches_time_evicted: Int
  batches_memory_evicted: Int
  per_window_evicted: List<WindowEvictCount>
}

struct WindowEvictCount {
  window_name: String
  time_evicted: Int
}

struct ProviderWindow {
  table: String
  query: String
  refresh: Duration?
  rows: List<Map<String, Value>>
}

// -- Sink dispatch ----------------------------------------------------------

struct SinkDispatcher {
  routes: List<SinkRouteBinding>
  default_sinks: List<SinkRuntime>
  error_sinks: List<SinkRuntime>
  monitor_sinks: List<SinkRuntime>
  all_sinks: List<SinkRuntime>
}

struct SinkRuntime {
  name: String
  spec: ResolvedSinkSpec
  output_fields: List<String>?
  wf_meta_disable: List<String>
  handle: String
}

struct SinkRouteBinding {
  patterns: List<String>
  sinks: List<SinkRuntime>
}

// -- Error state ------------------------------------------------------------

state CoreReason {
  WindowBuild
  RuleExec
  DataFormat
  Sink
  General
}
