// ---------------------------------------------------------------------------
// config domain — configuration management
// Crate: wf-config
// ---------------------------------------------------------------------------

// -- Trigger messages --------------------------------------------------------

command ConfigLoadRequest {
  path: String
  overlay_paths: List<String>
  var_context: ConfigVarContext
  work_dir: String
}

command ConfigSnapshot {
  tree: String
}

command TOMLString {
  raw: String
}

// -- Variable resolution (wf-vars) -------------------------------------------

struct ConfigVarContext {
  explicit_vars: Map
  file_vars: Map
}

state SourceAtom {
  File
  Explicit
  Env
  Default
}

struct TracedValue {
  value: String
  source: SourceAtom
  label: String
}

struct ExpandedToml {
  resolved: String
}

// -- Fusion config ----------------------------------------------------------

struct FusionConfig {
  mode: FusionMode
  runtime: RuntimeConfig
  window_defaults: WindowDefaults
  windows: List<WindowConfig>
  sinks: String
  work_root: String?
  logging: LoggingConfig
  metrics: MetricsConfig
  output: OutputConfig
  vars: Map<String, String>
  sources: List<SourceConfig>
  admin_api: AdminApiConf
  project_remote: ProjectRemoteConf
}

state FusionMode {
  Daemon
  Batch
}

struct RuntimeConfig {
  executor_parallelism: Int
  rule_exec_timeout: HumanDuration
  schemas: String
  rules: String
}

struct LoggingConfig {
  file: String
  format: LogFormat
  level: String
}

state LogFormat {
  Plain
  Json
}

struct MetricsConfig {
  enabled: Bool
  report_interval: HumanDuration
  prometheus_listen: String
  topn: MetricsTopNConfig
}

struct MetricsTopNConfig {
  enabled: Bool
  max: Int
  queue_capacity: Int
}

state OutputTimeZone {
  Utc
}

struct OutputConfig {
  time_format: String
  time_zone: OutputTimeZone
}

struct AdminApiTlsConf {
  enabled: Bool
  cert_file: String
  key_file: String
}

struct AdminApiAuthConf {
  mode: String
  token_file: String
}

struct AdminApiConf {
  enabled: Bool
  bind: String
  request_timeout_ms: Int
  max_body_bytes: Int
  tls: AdminApiTlsConf
  auth: AdminApiAuthConf
}

struct RepoGroupConf {
  repo: String
  init_version: String
}

struct ProjectRemoteConf {
  enabled: Bool
  repo: String
  init_version: String
  models: RepoGroupConf?
  infra: RepoGroupConf?
}

// -- Window configuration ----------------------------------------------------

struct WindowDefaults {
  evict_interval: HumanDuration
  max_window_bytes: ByteSize
  max_total_bytes: ByteSize
  evict_policy: EvictPolicy
  watermark: HumanDuration
  allowed_lateness: HumanDuration
  late_policy: LatePolicy
}

struct WindowOverride {
  mode: String
  partition_key: String
  max_window_bytes: ByteSize
  over_cap: HumanDuration
  evict_policy: EvictPolicy
  watermark: HumanDuration
  allowed_lateness: HumanDuration
  late_policy: LatePolicy
}

struct WindowConfig {
  name: String
  mode: DistMode
  max_window_bytes: ByteSize
  over_cap: HumanDuration
  evict_policy: EvictPolicy
  watermark: HumanDuration
  allowed_lateness: HumanDuration
  late_policy: LatePolicy
}

// -- Source configuration ----------------------------------------------------

struct SourceConfig {
  name: String?
  source_type: String?
  connect: String?
  enabled: Bool
  params: Map<String, String>
}

// -- Custom types ------------------------------------------------------------

struct HumanDuration {
  duration: String
}

struct ByteSize {
  bytes: String
}

state DistMode {
  Local
  Replicated
  Partitioned
}

state EvictPolicy {
  TimeFirst
  Lru
}

state LatePolicy {
  Drop
  Revise
  SideOutput
}

// -- Sink configuration ------------------------------------------------------

struct SinkConfigBundle {
  connectors: Map<String, ConnectorDefRaw>
  defaults: DefaultsBody
  business: List<FlexGroup>
  infra_default: FixedGroup?
  infra_error: FixedGroup?
  infra_monitor: FixedGroup?
}

struct FixedGroup {
  name: String
  expect: GroupExpectSpec?
  wf_meta_disable: List<String>
  sinks: List<ResolvedRouteSink>
  parallel: Int
}

struct FlexGroup {
  name: String
  parallel: Int
  windows: WildArray
  tags: List<String>
  wf_meta_disable: List<String>
  expect: GroupExpectSpec?
  sinks: List<ResolvedRouteSink>
}

struct ResolvedRouteSink {
  spec: ResolvedSinkSpec
  fields: List<String>?
}

struct RouteFile {
  version: String?
  sink_group: RouteGroup
}

struct RouteGroup {
  name: String
  tags: List<String>?
  parallel: Int?
  windows: StringOrArray?
  wf_meta_disable: List<String>
  expect: GroupExpectSpec?
  sinks: List<RouteSink>
}

struct RouteSink {
  connect: String
  name: String?
  params: Map
  fields: StringOrArray?
  tags: List<String>?
  expect: SinkExpectOverride?
}

struct ConnectorDefRaw {
  id: String
  kind: String
  allow_override: List<String>
  params: String?
}

struct ConnectorTomlFile {
  connectors: List<ConnectorDefRaw>
}

struct StringOrArray {
  values: List<String>
}

struct WildArray {
  patterns: List<String>
}

struct GroupExpectSpec {
  required: Bool
}

struct SinkExpectOverride {
  required: Bool
}

struct DefaultsBody {
  tags: List<String>
  expect: GroupExpectSpec?
}

// -- Config loader (public API) ----------------------------------------------

struct FusionConfigLoader {
  base_path: String
  overlay_paths: List<String>
  ctx: ConfigVarContext
  work_dir: String
}

struct RawFusionConfigTree {
  value: String
  origins: Map
}

struct RawFusionConfigChange {
  path: String
  old_value: String
  new_value: String
  old_origin: String
  new_origin: String
}

struct ResolvedConfigVar {
  key: String
  value: String
  source: String
}

// -- Change detection --------------------------------------------------------

state FusionChangeKind {
  Rules
  Vars
  Runtime
  Sources
  Windows
  Sinks
  Logging
  Metrics
  Mode
  Output
  Unknown
}

state FusionReloadDisposition {
  HotReloadSupported
  RequiresRestart
  Unsupported
}

struct ClassifiedFusionConfigChange {
  change: RawFusionConfigChange
  kind: FusionChangeKind
  disposition: FusionReloadDisposition
  reason: String
}

struct FusionReloadPlan {
  hot_reload: List<ClassifiedFusionConfigChange>
  requires_restart: List<ClassifiedFusionConfigChange>
  unsupported: List<ClassifiedFusionConfigChange>
}

// -- Error states ------------------------------------------------------------

state ConfigReason {
  Load
  Parse
  Validation
  Path
  Sink
  Lang
  Vars
  General
}

state VarsReason {
  Resolve
  Template
  Toml
  General
}
