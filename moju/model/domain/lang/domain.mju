// ---------------------------------------------------------------------------
// lang domain — WFL DSL language concepts
// Crate: wf-lang
// ---------------------------------------------------------------------------

command CompileRequest {
  source: String
  schema_paths: List<String>
}

struct WindowSchema {
  name: String
  streams: List<String>
  time_field: String
  over: String
  fields: List<FieldDef>
}

struct FieldDef {
  name: String
  field_type: FieldType
}

state BaseType {
  Chars
  Digit
  Float
  Bool
  Time
  Ip
  Hex
}

state FieldType {
  Base
  Array
  ArrayAny
  Object
}

// -- WFL File ---------------------------------------------------------------

struct WflFile {
  uses: List<UseDecl>
  patterns: List<PatternDecl>
  rules: List<RuleDecl>
  tests: List<TestBlock>
  yield_presets: List<YieldPresetDecl>
}

struct UseDecl {
  path: String
}

// -- WFG Scenario -----------------------------------------------------------

struct WfgFile {
  uses: List<UseDecl>
  scenario: ScenarioDecl
  syntax: SyntaxScenario?
}

struct ScenarioDecl {
  name: String
  seed: Int
  time_clause: TimeClause
  total: Int
  streams: List<StreamBlock>
  injects: List<InjectBlock>
  faults: FaultsBlock?
  oracle: OracleBlock?
}

struct TimeClause {
  start: String
  duration: Duration
}

struct SyntaxScenario {
  attrs: List<ScenarioAttr>
  inline_annos: List<ScenarioAttr>
  traffic: TrafficBlock
  injection: SyntaxInjectionBlock?
  expect: ExpectBlock?
}

struct ScenarioAttr {
  key: String
  value: AttrValue
}

state AttrValue {
  Number
  Duration
  String
  Bool
}

struct TrafficBlock {
  streams: List<SyntaxStreamDecl>
}

struct SyntaxStreamDecl {
  stream: String
  rate: RateExpr
}

state RateExpr {
  Constant
  Wave
  Burst
  Timeline
}

state WaveShape {
  Sine
  Triangle
  Square
}

struct TimelineSegment {
  start: Duration
  end: Duration
  rate: Rate
}

struct SyntaxInjectionBlock {
  cases: List<SyntaxInjectCase>
}

struct SyntaxInjectCase {
  mode: InjectCaseMode
  percent: Float
  target_rule: String?
  stream: String
  seq: SeqBlock
}

state InjectCaseMode {
  Hit
  NearMiss
  Miss
}

struct SeqBlock {
  entity: String
  steps: List<SeqStep>
}

state SeqStep {
  Use
  Not
}

struct FieldPredicate {
  field: String
  value: AttrValue
}

struct ExpectBlock {
  checks: List<ExpectCheck>
}

struct ExpectCheck {
  metric: ExpectMetric
  rule: String
  op: CompareOp
  value: ExpectValue
}

state ExpectMetric {
  Hit
  NearMiss
  Miss
  Precision
  Recall
  Fpr
  LatencyP95
}

state CompareOp {
  Gte
  Lte
  Gt
  Lt
  Eq
}

state ExpectValue {
  Percent
  Number
  Duration
}

struct Rate {
  count: Int
  unit: RateUnit
}

state RateUnit {
  PerSecond
  PerMinute
  PerHour
}

struct StreamBlock {
  alias: String
  window: String
  rate: Rate
  overrides: List<FieldOverride>
}

struct FieldOverride {
  field_name: String
  gen_expr: GenExpr
}

state GenExpr {
  StringLit
  NumberLit
  BoolLit
  GenFunc
}

struct GenArg {
  name: String?
  value: GenExpr
}

struct InjectBlock {
  rule: String
  streams: List<String>
  lines: List<InjectLine>
}

struct InjectLine {
  mode: InjectMode
  percent: Float
  params: List<ParamAssign>
  use_steps: List<InjectUseStep>
}

struct InjectUseStep {
  count: Int
  predicates: List<FieldPredicate>
}

state InjectMode {
  Hit
  NearMiss
  NonHit
}

struct FaultsBlock {
  faults: List<FaultLine>
}

state FaultType {
  OutOfOrder
  Late
  Duplicate
  Drop
}

struct FaultLine {
  fault_type: FaultType
  percent: Float
}

struct OracleBlock {
  params: List<ParamAssign>
}

struct ParamAssign {
  key: String
  value: ParamValue
}

state ParamValue {
  Number
  String
  Bool
}

struct PatternDecl {
  name: String
  params: List<String>
  body: String
}

// -- Rule -------------------------------------------------------------------

struct RuleDecl {
  name: String
  meta: MetaBlock
  events: EventsBlock
  match_clause: MatchClause
  each_clause: EachClause
  score: ScoreExpr
  joins: List<JoinClause>
  pipeline_stages: List<PipelineStage>
  entity: EntityClause
  yield_clause: YieldClause
  conv: ConvClause
  limits: LimitsBlock
}

struct MetaBlock {
  entries: List<MetaEntry>
}

struct MetaEntry {
  key: String
  value: String
}

struct PipelineStage {
  match_clause: MatchClause
  joins: List<JoinClause>
}

// -- Events -----------------------------------------------------------------

struct EventsBlock {
  events: List<EventDecl>
}

struct EventDecl {
  alias: String
  window: String
  filter: String
}

// -- Match ------------------------------------------------------------------

struct MatchClause {
  keys: List<FieldRef>
  key_mapping: List<KeyMapItem>?
  duration: Duration
  window_mode: WindowMode
  on_event: List<MatchStep>
  on_close: CloseBlock?
}

struct EachClause {
  alias: String
  filter: Expr?
}

struct KeyMapItem {
  logical_name: String
  source_field: FieldRef
}

struct MatchStep {
  branches: List<StepBranch>
}

struct StepBranch {
  label: String?
  source: String
  field: FieldSelector?
  guard: Expr?
  pipe: PipeChain
}

struct PipeChain {
  transforms: List<Transform>
  measure: Measure
  cmp: CmpOp
  threshold: Expr
}

state Transform {
  Distinct
}

state Measure {
  Count
  Sum
  Avg
  Min
  Max
}

// -- Close ------------------------------------------------------------------

struct CloseBlock {
  mode: CloseMode
  steps: List<MatchStep>
}

state CloseMode {
  Or
  And
}

state CloseTrigger {
  Timeout
  Flush
  Eos
}

state WindowMode {
  Sliding
  Fixed
  Session
}

// -- Expression -------------------------------------------------------------

state FieldSelector {
  Dot
  Bracket
}

state FieldRef {
  Simple
  Qualified
  Bracketed
}

state CmpOp {
  Eq
  Ne
  Lt
  Gt
  Le
  Ge
}

state BinOp {
  Add
  Sub
  Mul
  Div
  Mod
  And
  Or
  Eq
  Ne
  Lt
  Gt
  Le
  Ge
}

state SystemVar {
  Score
  EventFirstTime
  EventLastTime
  EvidenceStartTime
  EvidenceEndTime
  WindowStartTime
  WindowEndTime
  EmitTime
}

state Expr {
  Number
  StringLit
  Bool
  SystemVar
  WfuMeta
  Field
  BinOp
  Neg
  FuncCall
  InList
  IfThenElse
  Object
  Array
}

state WfuMetaField {
  Id
  RuleName
  Score
  EntityType
  EntityId
  Origin
  CloseReason
  FiredAt
  EmitTime
  Summary
}

state WfuIntermediateMetaField {
  RuleName
  Score
  EntityType
  EntityId
}

// -- Clauses ----------------------------------------------------------------

struct ScoreExpr {
  expr: Expr
}

struct EntityClause {
  entity_type: EntityTypeVal
  id_expr: Expr
}

state EntityTypeVal {
  Ident
  StringLit
}

struct YieldClause {
  target: String
  version: Int?
  presets: List<String>
  args: List<NamedArg>
}

struct NamedArg {
  name: String
  value: Expr
}

struct YieldPresetDecl {
  name: String
  args: List<NamedArg>
}

struct PatternOrigin {
  pattern: String
  args: List<NamedArg>
}

struct YieldField {
  name: String
  value: String
}

// -- Join -------------------------------------------------------------------

struct JoinClause {
  target_window: String
  mode: JoinMode
  conditions: List<JoinCondition>
}

state JoinMode {
  Snapshot
  Asof
  Anti
}

struct JoinCondition {
  left: FieldRef
  right: FieldRef
}

// -- Conv -------------------------------------------------------------------

struct ConvClause {
  chains: List<ConvChain>
}

struct ConvChain {
  steps: List<ConvStep>
}

state ConvStep {
  Sort
  Top
  Dedup
  Where
}

struct SortKey {
  field: String
  descending: Bool
}

// -- Limits -----------------------------------------------------------------

struct LimitsBlock {
  items: List<LimitItem>
}

struct LimitItem {
  key: String
  value: String
}

// -- Contract / Test --------------------------------------------------------

struct TestBlock {
  name: String
  rule_name: String
  input: List<InputStmt>
  expect: List<ExpectStmt>
  options: TestOptions?
}

state InputStmt {
  Row
  Tick
}

struct FieldAssign {
  name: String
  value: Expr
}

state ExpectStmt {
  Hits
  HitAssert
}

state HitAssert {
  Score
  Origin
  EntityType
  EntityId
  Field
}

struct TestOptions {
  close_trigger: CloseTrigger?
  eval_mode: EvalMode?
  permutation: PermutationMode?
  runs: Int?
}

state EvalMode {
  Strict
  Lenient
}

state PermutationMode {
  Shuffle
}

// -- Compilation plans (compiled AST -> runtime) --------------------------

struct RulePlan {
  name: String
  binds: List<BindPlan>
  match_plan: MatchPlan
  each_plan: EachPlan?
  joins: List<JoinPlan>
  entity_plan: EntityPlan
  yield_plan: YieldPlan
  score_plan: ScorePlan
  conv_plan: ConvPlan?
  limits_plan: LimitsPlan?
  pattern_origin: PatternOriginPlan?
}

struct BindPlan {
  alias: String
  window: String
  filter: ExprPlan?
}

struct MatchPlan {
  keys: List<FieldRef>
  key_map: List<KeyMapPlan>?
  window_spec: WindowSpec
  event_steps: List<StepPlan>
  close_steps: List<StepPlan>
  close_mode: CloseMode
  tracked_bind_aliases: List<String>
  tracked_bind_fields: Map<String, List<String>>
  tracked_plain_fields: List<String>
}

struct KeyMapPlan {
  logical_name: String
  source_alias: String
  source_field: String
}

state WindowSpec {
  Sliding
  Fixed
  Session
}

struct StepPlan {
  branches: List<BranchPlan>
}

struct BranchPlan {
  label: String?
  source: String
  field: FieldSelector?
  guard: ExprPlan?
  agg: AggPlan
}

struct AggPlan {
  transforms: List<Transform>
  measure: Measure
  cmp: CmpOp
  threshold: ExprPlan
}

struct EachPlan {
  alias: String
  filter: ExprPlan?
}

struct PatternOriginPlan {
  pattern: String
  args: List<NamedArg>
}

struct JoinPlan {
  right_window: String
  mode: JoinMode
  conds: List<JoinCondPlan>
}

struct JoinCondPlan {
  left: FieldRef
  right: FieldRef
}

struct LimitsPlan {
  max_memory_bytes: Int?
  max_instances: Int?
  max_throttle: RateSpec?
  on_exceed: ExceedAction
}

state ExceedAction {
  Throttle
  DropOldest
  FailRule
}

struct RateSpec {
  count: Int
  per: Duration
}

struct EntityPlan {
  entity_type: String
  entity_id_expr: ExprPlan
}

struct ScorePlan {
  expr: ExprPlan
}

struct YieldPlan {
  target: String
  version: Int?
  fields: List<YieldField>
}

struct ConvPlan {
  chains: List<ConvChainPlan>
}

struct ConvChainPlan {
  ops: List<ConvOpPlan>
}

state ConvOpPlan {
  Sort
  Top
  Dedup
  Where
}

struct SortKeyPlan {
  expr: ExprPlan
  descending: Bool
}

state ExprPlan {
  Const
  Field
  Binary
  FuncCall
}

// -- Error types -------------------------------------------------------------

struct CheckError {
  severity: Severity
  message: String
  rule: String?
  test: String?
}

state Severity {
  Error
  Warning
}

state LangReason {
  Parse
  Validation
  Compile
  General
}
