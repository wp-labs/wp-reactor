// ---------------------------------------------------------------------------
// runtime domain — runtime orchestration for wf-runtime crate (crates/wf-runtime)
// Static model: CLI entry, reactor lifecycle, hot reload, engine tasks,
// receiver, alert dispatch, external runtime, metrics, data source,
// sink factory, perf diagnostics, and runtime error reasons.
// ---------------------------------------------------------------------------

// =============================================================
// CliEntry — CLI entry point
// =============================================================

struct Cli {
  command: Commands
}

state Commands {
  Run
  Config
}

state ConfigCommands {
  Render
  Origins
  Vars
  Diff
}

struct ConfigLoadArgs {
  config: String
  overlay: List<String>
  var: List<String>
  work_dir: String?
}

struct CompareConfigLoadArgs {
  to_config: String?
  to_overlay: List<String>
  to_var: List<String>
  to_work_dir: String?
}

struct PathFilterArgs {
  path_prefix: List<String>
}

struct VarFilterArgs {
  var_prefix: List<String>
}

struct ResolvedConfigLoad {
  config_path: String
  overlay_paths: List<String>
  runtime_base_dir: String
  config_ctx: ConfigVarContext
}

state EngineReason {
  Cli
  Config
  Runtime
  General
}

// =============================================================
// ReactorLifecycle — reactor bootstrap, rule compilation, task
// group spawning, graceful shutdown, and signal handling
// =============================================================

struct Reactor {
  cancel: String
  rule_cancel: String
  head_watchers: List<String>
  actor_watch: String
  tail_watchers: List<String>
  rule_watch: String
  detached_rule_watchers: List<String>
  router: String
  sink_fanout: SinkFanout?
  metrics: RuntimeMetrics?
  intermediate_targets: List<String>
  eos_tx: String
  current_raw: RawFusionConfigTree
  current_config: FusionConfig
  base_dir: String
  reload_drain_timeout: Duration
  control_rx: String
  control_tx: String
}

struct BootstrapData {
  rules: List<RunRule>
  router: String
  dispatcher: String
  schema_count: Int
  schemas: List<WindowSchema>
  window_configs: List<WindowConfig>
  intermediate_targets: List<String>
  external_runtime: ExternalRuntime?
}

struct RunRule {
  kind: RunRuleKind
  executor: RuleExecutor
  window_aliases: Map<String,List<String>>
}

state RunRuleKind {
  Match
  Each
  Stats
}

struct TaskGroup {
  name: String
  handles: List<String>
}

state ShutdownTrigger {
  Signal
  Internal
}

state ReloadOutcome {
  Applied
  Blocked
}

state RunOutcome {
  Normal
  RestartRequested
}

state ReloadRequest {
  Reload
  Restart
}

struct RuntimeControlHandle {
  tx: String
  cancel: String
}

struct ParsedRuleFile {
  path: String
  source: String
  file: WflFile
}

// =============================================================
// HotReload — zero-downtime rule updates via atomic task swap
// =============================================================

struct PreparedRuleReload {
  plan: FusionReloadPlan
  next_raw: RawFusionConfigTree
  next_config: FusionConfig
  next_rules: List<RunRule>
  next_intermediate_targets: List<String>
  next_schemas: List<WindowSchema>
  added_schemas: List<WindowSchema>
  added_window_configs: List<WindowConfig>
  modified_schemas: List<WindowSchema>
  modified_window_configs: List<WindowConfig>
  next_window_configs: List<WindowConfig>
}

state ReloadPreparation {
  Ready
  Blocked
}

struct CompiledReloadArtifacts {
  run_rules: List<RunRule>
  intermediate_targets: List<String>
  runtime_schemas: List<WindowSchema>
  runtime_window_configs: List<WindowConfig>
}

// =============================================================
// EngineTask — concurrent rule / stats / conv-stage tasks with
// window source lookup and progress tracking
// =============================================================

struct RuleTaskConfig {
  machine: CepStateMachine?
  each_alias: String?
  each_time_field: String?
  executor: RuleExecutor
  window_sources: List<WindowSource>
  sink_fanout: SinkFanout
  cancel: String
  timeout_scan_interval: Duration
  router: String
  metrics: RuntimeMetrics?
  intermediate_targets: List<String>
  pipe_registry: String
  eos_flush: String
  push_rx: String?
  shard_index: Int?
  shard_count: Int
  key_partitioned: Bool
  progress: Map<String,Int>
  conv_sink: String?
}

struct StatsTaskConfig {
  stats: StatsExecutor
  executor: RuleExecutor
  window_sources: List<WindowSource>
  sink_fanout: SinkFanout
  cancel: String
  router: String
  metrics: RuntimeMetrics?
  time_field: String?
  timeout_scan_interval: Duration
  intermediate_targets: List<String>
  pipe_registry: String
  eos_flush: String
  push_rx: String?
  progress: Map<String,Int>
  shard_index: Int?
  shard_count: Int
  merge_rx: String?
  merge_tx: String?
  mask_cache: String?
}

struct WindowSource {
  window_name: String
  window: String
  notify: String
  aliases: List<String>
}

struct ConvStageConfig {
  executor: RuleExecutor
  conv_plan: ConvPlan?
  keys: String
  over: Duration
  bucket_align: Duration
  limits: LimitsPlan?
  shared_limits: String?
  barrier: String
  sink_fanout: SinkFanout
  router: String
  metrics: RuntimeMetrics?
  rx: String
  cancel: String
  eos: String
  timeout_scan_interval: Duration
}

struct ConvStageTask {
  executor: RuleExecutor
  conv_plan: ConvPlan?
  keys: String
  over: Duration
  bucket_align: Duration
  limits: LimitsPlan?
  shared_limits: String?
  barrier: String
  sink_fanout: SinkFanout
  router: String
  metrics: RuntimeMetrics?
  rx: String
  cancel: String
  eos: String
  timeout_scan_interval: Duration
  buckets: Map<Int,List<CloseOutput>>
  last_min_wm: Int
  last_min_wm_at: DateTime
}

struct RuleTask {
  task_id: String
  machine: CepStateMachine?
  each_alias: String?
  each_time_field: String?
  executor: RuleExecutor
  conv_plan: ConvPlan?
  conv_sink: String?
  sources: List<WindowSource>
  aliases: Map<String,List<String>>
  ordered_aliases: Map<String,List<String>>
  cursors: Map<String,Int>
  sink_fanout: SinkFanout
  router: String
  metrics: RuntimeMetrics?
  intermediate_targets: List<String>
  pipe_registry: String
  eos_flush: String
  last_activity_wall: DateTime
  timeout_scan_interval: Duration
  push_rx: String?
  pushed_seq: Int
  shard_index: Int?
  shard_count: Int
  advance_nanos: Int
  scan_nanos: Int
  emit_nanos: Int
  exec_nanos: Int
  close_exec_nanos: Int
  append_nanos: Int
  fanout_nanos: Int
  last_profile_dump: DateTime
  cached_wall_nanos: Int
  progress: Map<String,Int>
  emit_sample_remaining: Int
  append_sample_remaining: Int
  last_reported_instances: Int
  pending_alerts: String
  pipe_state: String
  each_direct: Bool
  deferred: String?
  snapshot_pins: List<Int>
}

struct StatsTask {
  task_id: String
  stats: StatsExecutor
  executor: RuleExecutor
  cancel: String
  sources: List<WindowSource>
  sink_fanout: SinkFanout
  router: String
  metrics: RuntimeMetrics?
  time_field: String?
  intermediate_targets: List<String>
  eos_flush: String
  push_rx: String?
  progress: Map<String,Int>
  cursors: Map<String,Int>
  shard_index: Int?
  shard_count: Int
  merge_rx: String?
  merge_tx: String?
  mask_cache: String?
  window_start: Int?
  window_end: Int?
  last_watermark: Int
  last_activity_wall: DateTime
  timeout_scan_interval: Duration
  last_reported_over_limit: Int
  last_reported_spill_evictions: Int
  last_reported_spill_readbacks: Int
  last_reported_spill_scan_ns: Int
  last_reported_spill_clone_ns: Int
  last_reported_spill_write_ns: Int
  last_reported_spill_calls: Int
}

struct RegistryLookup {
  router: String
  max_seq: Int?
  source_window: String?
}

// =============================================================
// Receiver — data ingestion (Arrow IPC / replay routes)
// =============================================================

struct ReplayRoute {
  stream_name: String
  stream_tag_field: String
}

struct WindowMiss {
  stream_tag_field: String
  stream_tag: String?
  reason: WindowMissReason
  sample_payload: String
  payload_bytes: Int
  rows: Int
}

state WindowMissReason {
  UnknownStreamSchema
  MissingStreamTagField
}

state ColumnBuilder {
  Utf8
  Int64
  Float64
  Bool
  TimeNanos
}

// =============================================================
// AlertDispatch — alert batching and sink fan-out
// =============================================================

state AlertBatch {
  Rows
  Columns
}

struct SinkFanout {
  by_sink: Map<Int,List<String>>
  rr: Map<Int,Int>
  cache: String
  dispatcher: String?
  warned_no_sink: String
}

// =============================================================
// ExternalRuntime — external runtime backends
// =============================================================

struct ExternalRuntime {
  redis: RedisBackend
}

struct RedisBackend {
}

// =============================================================
// Metrics — operational metrics, histograms, snapshots, alloc
// =============================================================

struct RuntimeMetrics {
  receiver_connections_total: Int
  receiver_frames_total: Int
  receiver_rows_total: Int
  receiver_decode_errors_total: Int
  receiver_read_errors_total: Int
  source_types: Map<String,String>
  receiver_source_rows_total: Map<String,Int>
  receiver_source_machine_rows: String
  receiver_source_decode_errors_total: Map<String,Int>
  receiver_source_read_errors_total: Map<String,Int>
  receiver_window_miss_total: String
  router_route_calls_total: Int
  router_delivered_total: Int
  router_dropped_late_total: Int
  router_skipped_non_local_total: Int
  router_source_route_errors_total: Map<String,Int>
  rule_events_total: Map<String,Int>
  rule_matches_total: Map<String,Int>
  rule_instances: Map<String,Int>
  rule_cursor_gap_total: Map<String,Map<String,Int>>
  rule_stats_over_limit_total: Map<String,Int>
  alert_emitted_total: Map<String,Int>
  alert_emitted_detail_shards: List<String>
  alert_channel_send_failed_total: Int
  alert_sink_dispatch_failed_total: Int
  alert_channel_full_total: Int
  alert_channel_depth: Int
  alert_append_failed_total: Int
  alert_dispatch_total: Int
  alert_no_sink_records_total: Int
  alert_drain_dropped_records_total: Int
  alert_escalate_failed_total: Int
  alert_append_nanos: Int
  evictor_sweeps_total: Int
  evictor_time_evicted_total: Int
  evictor_memory_evicted_total: Int
  window_memory_bytes: Map<String,Int>
  window_fanout_queued: Map<String,Int>
  window_fanout_capacity: Map<String,Int>
  window_allocated_bytes: Map<String,Int>
  window_mailbox_inflight: Map<String,Int>
  window_mailbox_budget: Map<String,Int>
  window_capacity_bytes: Map<String,Int>
  window_rows: Map<String,Int>
  window_batches: Map<String,Int>
  window_acked_lag: Map<String,Int>
  window_append_total: Map<String,Int>
  window_evict_total: Map<String,Int>
  window_late_total: Map<String,Int>
  receiver_decode_seconds: Histogram
  alert_dispatch_seconds: Histogram
  event_e2e_latency_seconds: Histogram
  rule_scan_timeout_seconds: Map<String,Histogram>
  rule_flush_seconds: Map<String,Histogram>
}

struct Histogram {
  upper_bounds_nanos: List<Int>
  bucket_counts: List<Int>
  sum_nanos: Int
}

struct HistogramSnapshot {
  upper_bounds_nanos: List<Int>
  bucket_counts: List<Int>
  sum_seconds: Float
}

struct IntervalRates {
  row_s: Float
  late_s: Float
  rules_s: Float
  sm_s: Float
  out_s: Float
  memory_bytes: Int
}

struct IntervalSnapshot {
  at: DateTime
  rx_rows: Int
  dropped_late: Int
  rule_matches: Int
  rule_instances: Int
  alert_dispatch: Int
  window_bytes: Int
}

struct TotalCounts {
  rows: Int
  late: Int
  rules: Int
  out: Int
  sm_delta: Int
}

struct RunSummary {
  interval_count: Int
  sum_row_s: Float
  sum_late_s: Float
  sum_rules_s: Float
  sum_sm_s: Float
  sum_out_s: Float
  sum_memory_bytes: Float
  max_row_s: Float
  max_late_s: Float
  max_rules_s: Float
  max_sm_s: Float
  max_out_s: Float
  max_memory_bytes: Int
}

struct MetricsRecord {
  fields: Map<String,String>
}

struct MetricsSnapshot {
  source_types: Map<String,String>
  receiver_connections: Int
  receiver_frames: Int
  receiver_source_rows: Map<String,Int>
  receiver_source_machine_rows: Map<String,Map<String,Int>>
  receiver_source_decode_errors: Map<String,Int>
  receiver_source_read_errors: Map<String,Int>
  receiver_window_misses: Map<String,Map<String,Int>>
  router_route_calls: Int
  router_delivered: Int
  router_dropped_late: Int
  router_skipped_non_local: Int
  router_source_route_errors: Map<String,Int>
  rule_events: Map<String,Int>
  rule_matches: Map<String,Int>
  rule_instances: Map<String,Int>
  rule_cursor_gaps: Map<String,Map<String,Int>>
  rule_stats_over_limit: Map<String,Int>
  alert_emitted: Map<String,Int>
  alert_emitted_detail: Map<String,Map<String,Map<String,Int>>>
  alert_channel_send_failed: Int
  alert_sink_dispatch_failed: Int
  alert_channel_full: Int
  alert_channel_depth: Int
  alert_append_failed: Int
  alert_dispatch: Int
  alert_no_sink_records: Int
  alert_drain_dropped_records: Int
  alert_escalate_failed: Int
  alert_append_nanos: Int
  evictor_sweeps: Int
  evictor_time_evicted: Int
  evictor_memory_evicted: Int
  window_memory_bytes: Map<String,Int>
  window_allocated_bytes: Map<String,Int>
  window_fanout_queued: Map<String,Int>
  window_fanout_capacity: Map<String,Int>
  window_mailbox_inflight: Map<String,Int>
  window_mailbox_budget: Map<String,Int>
  window_capacity_bytes: Map<String,Int>
  window_rows: Map<String,Int>
  window_batches: Map<String,Int>
  window_acked_lag: Map<String,Int>
  window_append: Map<String,Int>
  window_evict: Map<String,Int>
  window_late: Map<String,Int>
  receiver_decode_latency: HistogramSnapshot
  alert_dispatch_latency: HistogramSnapshot
  event_e2e_latency: HistogramSnapshot
  rule_scan_timeout: Map<String,HistogramSnapshot>
  rule_flush: Map<String,HistogramSnapshot>
  alloc: AllocStats?
}

struct AllocStats {
  current_rss: Int
  peak_rss: Int
  current_commit: Int
  peak_commit: Int
  page_faults: Int
}

// =============================================================
// DataSource — batch data source adapter
// =============================================================

struct DataSourceBatchSource {
  unique id: String
  inner: String
  schema: String
  format: String
  schemas: List<WindowSchema>
  schema_cache: Map<String,String>
  stream_tag_field: String
  dynamic_ndjson: Bool
  batch_tags: List<String>
  window_misses: List<WindowMiss>
}

// =============================================================
// SinkFactory — sink construction registry
// =============================================================

struct SinkFactoryRegistry {
  factories: Map<String,String>
}

// =============================================================
// PerfDiagnostics — staged reload perf diagnostics
// =============================================================

struct PerfDiagController {
  stages: String
  current: Int
  control: RuntimeControlHandle?
  baseline: ReloadBaseline?
}

struct AppliedStage {
  index: Int
  reloaded: Bool
}

struct ReloadBaseline {
  raw: RawFusionConfigTree
  config: FusionConfig
}

struct SentinelRecord {
  round: Int
  n: Int
  start_ns: Int
  emit_ns: Int
}

struct SentinelTaskConfig {
  router: String
  sink_fanout: SinkFanout
  controller: PerfDiagController
  cancel: String
  rx: String
}

// =============================================================
// RuntimeError — runtime failure classification
// =============================================================

state RuntimeReason {
  Bootstrap
  Shutdown
  Core
  General
}
