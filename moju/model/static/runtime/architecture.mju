// ---------------------------------------------------------------------------
// runtime domain — module architecture
// Crate: wf-runtime
// ---------------------------------------------------------------------------

module CliEntry {
  layer Interface
  owns Admin, Cli, Commands, ConfigCommands, ConfigLoadArgs, CompareConfigLoadArgs, PathFilterArgs, VarFilterArgs, ResolvedConfigLoad, EngineReason
  responsible_for "CLI entry point — parse commands (run, config), resolve config load arguments, and dispatch to the reactor lifecycle"
}

module ReactorLifecycle {
  layer Application
  owns Reactor, BootstrapData, RunRule, RunRuleKind, TaskGroup, ShutdownTrigger, ReloadOutcome, ReloadRequest, RunOutcome, RuntimeControlHandle, ParsedRuleFile, RunCommand, ShutdownSignal, ConfigChange, IncomingData
  responsible_for "Reactor bootstrap, rule compilation, task group spawning, graceful shutdown, and signal handling"
}

module HotReload {
  layer Application
  owns PreparedRuleReload, ReloadPreparation, CompiledReloadArtifacts
  responsible_for "Zero-downtime rule updates — prepare reload plans and compile rule artifacts before atomic task swap"
}

module EngineTask {
  layer Application
  owns RuleTaskConfig, StatsTaskConfig, WindowSource, ConvStageConfig, ConvStageTask, RuleTask, StatsTask, RegistryLookup
  responsible_for "Concurrent rule/stats/conv-stage task orchestration with window source lookup and progress tracking"
}

module Receiver {
  layer Infrastructure
  owns ReplayRoute, WindowMiss, WindowMissReason, ColumnBuilder
  responsible_for "Accept Arrow IPC data streams over TCP or replay from files; track window misses and build output columns"
}

module AlertDispatch {
  layer Application
  owns AlertBatch, SinkFanout
  responsible_for "Batch alerts and fan out to configured sinks with round-robin load distribution"
}

module ExternalRuntime {
  layer Infrastructure
  owns ExternalRuntime, RedisBackend
  responsible_for "External runtime adapters (Redis) for sharing rule state across runtimes"
}

module Metrics {
  layer Infrastructure
  owns RuntimeMetrics, Histogram, HistogramSnapshot, IntervalRates, IntervalSnapshot, TotalCounts, RunSummary, MetricsRecord, MetricsSnapshot, AllocStats
  responsible_for "Operational metrics collection — histograms, interval snapshots, run summaries, record exports, and alloc stats"
}

module DataSource {
  layer Infrastructure
  owns DataSourceBatchSource
  responsible_for "Batch data source adapter wrapping external data sources with schema caching, dynamic NDJSON, and window-miss tracking"
}

module SinkFactory {
  layer Infrastructure
  owns SinkFactoryRegistry
  responsible_for "Construct sink runtimes from connector kinds via the sink factory registry"
}

module PerfDiagnostics {
  layer Application
  owns PerfDiagController, AppliedStage, ReloadBaseline, SentinelRecord, SentinelTaskConfig
  responsible_for "Performance diagnostics — staged reload baselines, applied-stage tracking, and sentinel task instrumentation"
}

module RuntimeError {
  layer Infrastructure
  owns RuntimeReason
  responsible_for "Runtime error classification (bootstrap, shutdown, core, general)"
}

dependency_rule RuntimeDeps {
  CliEntry -> ReactorLifecycle
  ReactorLifecycle -> EngineTask
  ReactorLifecycle -> HotReload
  ReactorLifecycle -> Receiver
  ReactorLifecycle -> AlertDispatch
  ReactorLifecycle -> ExternalRuntime
  ReactorLifecycle -> DataSource
  ReactorLifecycle -> SinkFactory
  ReactorLifecycle -> Metrics
  EngineTask -> Receiver
  EngineTask -> AlertDispatch
  EngineTask -> Metrics
  HotReload -> EngineTask
  Receiver -> Metrics
  DataSource -> Receiver
  PerfDiagnostics -> ReactorLifecycle
  PerfDiagnostics -> AlertDispatch
}
