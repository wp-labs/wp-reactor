// ---------------------------------------------------------------------------
// lang domain — flow verification cases
// ---------------------------------------------------------------------------

verify CompileRuleParses for flow CompileRule {
  given {
    CompileRequest.source = "demo.rule"
  }

  when CompileRequest

  expect {
    RulePlan.name == "demo.rule"
  }
}

verify ExplainRuleRenders for flow ExplainRule {
  given {
    CompileRequest.source = "demo.rule"
  }

  when CompileRequest

  expect {
    RuleExplanation.name == "demo.rule"
  }
}
