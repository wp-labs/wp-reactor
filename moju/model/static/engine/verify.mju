// ---------------------------------------------------------------------------
// engine domain — flow verification cases
// ---------------------------------------------------------------------------

verify ProcessEventsEmits for flow ProcessEvents {
  given {
    IncomingBatch.stream_name = "events"
  }

  when IncomingBatch

  expect {
    OutputRecord.wfx_id == "events"
  }
}

verify StatsWindowCloseProduces for flow StatsWindowClose {
  given {
    NewEvents.events = "samples"
  }

  when NewEvents

  expect {
    CloseOutput.rule_name == "samples"
  }
}
