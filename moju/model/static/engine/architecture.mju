// ---------------------------------------------------------------------------
// engine domain — module architecture
// Crate: wf-engine
// ---------------------------------------------------------------------------

module EventIngress {
  layer Interface
  owns DataSender, IncomingBatch, MemoryPressure, NewEvents

  responsible_for "Accept external data events, memory-pressure signals, and new-event pushes from the runtime and route them into the CEP engine"
}

module ColumnarBatch {
  layer DataFusion
  owns ColumnarBatch, CVec, CScalar, ColKind, ColRef, ColumnExpr, GuardMasks, StrFuncOp, ColumnarEvent, JoinRow

  responsible_for "Columnar batch representation, column kinds and expressions, guard masks, and row-view event bridging for deferred processing"
}

module WindowManager {
  layer DataFusion
  owns Window, WindowParams, TimedBatch, AppendOutcome, WindowRegistry, WindowDef, Router, RouteReport, WindowRouteOutcome, WindowMailbox, WindowMsg, IndexedRow, JoinIndex, KeyedRows, WindowProgress, ProviderWindow

  responsible_for "Time-ordered window buffer with per-window actor mailboxes, registry, stream-to-window routing, join indexes, and provider windows"
}

module WindowEviction {
  layer DataFusion
  owns Evictor, EvictionGate, EvictReport, WindowEvictCount

  responsible_for "Window memory/time eviction policy with a shared byte gate and pressure reporting"
}

module RuleFanout {
  layer DataFusion
  owns RuleFanout, RulePush, ShardKeySpec, WindowShardPartition, Subscription

  responsible_for "Fan out window appends to subscribed rules with single, key-sharded, and round-robin delivery modes; per-window key partition specs for rule_shards parallelism"
}

module MatchEngine {
  layer DataFusion
  owns CepStateMachine, InstanceKey, ScopeKey, Instance, StepState, BranchState, StepData, StepResult, StepProgress, StepOutcome, MatchedContext, CloseOutput, CloseReason, BindData, RollingStats, AliasState, SeqRuntime, SharedLimits, WindowLookup, AsofLookup, JoinKey, FieldSource, Event, Value, ValueKey, CoreReason

  responsible_for "NFA-style state machine for sequential event pattern matching with close-mode lifecycle, field sources, window/asof lookups, and core error reasons"
}

module StatsEngine {
  layer DataFusion
  owns StatsExecutor, StatsWindowState, StatsBucket, StatsBucketAccs, StatsCloseBucket, StatsCloseEntry, StatsAccum, NumericAccum, NumericSoA, NumericSoALayout, RowFieldSlot, SoAColGroup, RowFields, RowFieldLayout, SpillCreateSpec, TopEntry, DistinctSet, DistinctKey, StatsMaskCache, NumericKind

  responsible_for "Stats window accumulation in SoA columnar layout with distinct/top/numeric accumulators, row-field layouts, and spill create specs"
}

module SpillStore {
  layer DataFusion
  owns SpillStore, RedbSpillStore, MemSpillStore, NoopSpillStore, SpillError, Reader, Writer, RedbBatchWriter, AsyncPersister, BatchWriter, PersistError

  responsible_for "State-overflow spill-to-disk storage backends (redb/mem/noop), batched writers, and asynchronous persistence with error handling"
}

module AlertOutput {
  layer DataFusion
  owns OutputRecord, AlertOrigin, AlertColumnBatch, AlertColumnBuilder, YieldCol, ColumnData

  responsible_for "Alert record production from match results with origin tagging and columnar alert batch building"
}

module SinkDispatch {
  layer DataFusion
  owns SinkDispatcher, SinkRuntime, SinkRouteBinding, WfMetaDisableMatcher, WildmatchMatcher

  responsible_for "Route output records to configured sinks via wildcard matchers with default, error, and monitor fallback"
}

module PipeExecution {
  layer DataFusion
  owns Pipe, PipeRegistry

  responsible_for "Pipe (window-like source) definition and registry for piped rule inputs"
}

module ExternalCall {
  layer DataFusion
  owns ExternalCallHandler

  responsible_for "External service call handler backing the external() WFL function"
}

module RuleExecution {
  layer DataFusion
  owns RuleExecutor

  responsible_for "Execute a compiled rule plan across event/close paths, driving the match and stats state machines and producing output"
}

dependency_rule EngineDeps {
  EventIngress -> WindowManager
  EventIngress -> MatchEngine
  WindowManager -> RuleFanout
  WindowManager -> WindowEviction
  RuleFanout -> MatchEngine
  MatchEngine -> WindowManager
  MatchEngine -> AlertOutput
  MatchEngine -> SpillStore
  MatchEngine -> StatsEngine
  StatsEngine -> SpillStore
  AlertOutput -> SinkDispatch
  RuleExecution -> MatchEngine
  RuleExecution -> StatsEngine
  RuleExecution -> AlertOutput
  RuleExecution -> SpillStore
  RuleExecution -> ExternalCall
  PipeExecution -> RuleExecution
}
