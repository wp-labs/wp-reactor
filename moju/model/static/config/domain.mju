// ---------------------------------------------------------------------------
// config domain — configuration management (crates/wf-config)
// Static model: fusion config load, variable expansion, sink config,
// window config, and change detection.
// ---------------------------------------------------------------------------

// =============================================================
// FusionConfig — top-level fusion configuration
// =============================================================

state FusionMode {
  Daemon
  Batch
}

struct FusionConfigRaw {
  mode: FusionMode
  runtime: RuntimeConfig
  windows: String?
  sinks: String
  work_root: String?
  logging: LoggingConfig
  metrics: MetricsConfig
  output: OutputConfig
  vars: Map<String,String>
  sources: List<SourceConfig>
  sources_dir: String?
  admin_api: AdminApiConf
  project_remote: ProjectRemoteConf
}

struct FusionConfig {
  mode: FusionMode
  runtime: RuntimeConfig
  window_defaults: WindowDefaults
  windows: List<WindowConfig>
  sinks: String
  work_root: String?
  logging: LoggingConfig
  metrics: MetricsConfig
  output: OutputConfig
  vars: Map<String,String>
  sources: List<SourceConfig>
  admin_api: AdminApiConf
  project_remote: ProjectRemoteConf
}

struct RuntimeConfig {
  parse_parallelism: Int
  rule_parallelism: Int
  rule_exec_timeout: HumanDuration
  max_ingest_rate: Int?
  parse_buffer_bytes: Int
  window_buffer_bytes: Int
  schemas: String
  rules: String
}

struct WindowFileRaw {
  window_defaults: WindowDefaults
  window: Map<String,WindowOverride>
}

// =============================================================
// ConfigLoader — fusion config loading and overlay merge
// =============================================================

command ConfigLoadRequest {
  path: String
  overlay_paths: List<String>
  var_context: ConfigVarContext
  work_dir: String
}

struct FusionConfigLoader {
  base_path: String
  overlay_paths: List<String>
  ctx: ConfigVarContext
  work_dir: String?
}

struct RawFusionConfigTree {
  value: String
  origins: Map<String,String>
}

struct RawFusionConfigChange {
  path: String
  old_value: String?
  new_value: String?
  old_origin: String?
  new_origin: String?
}

struct ResolvedConfigVar {
  key: String
  value: String
  source: String
}

// =============================================================
// ConfigChange — config change detection and reload planning
// =============================================================

state FusionChangeKind {
  Rules
  Vars
  Runtime
  Sources
  Windows
  Sinks
  Output
  Logging
  Metrics
  Mode
  Unknown
}

state FusionReloadDisposition {
  HotReloadSupported
  RequiresRestart
  Unsupported
}

struct ClassifiedFusionConfigChange {
  change: RawFusionConfigChange
  kind: FusionChangeKind
  disposition: FusionReloadDisposition
  reason: String
}

struct FusionReloadPlan {
  hot_reload: List<ClassifiedFusionConfigChange>
  requires_restart: List<ClassifiedFusionConfigChange>
  unsupported: List<ClassifiedFusionConfigChange>
}

// =============================================================
// ConfigVars — config variable expansion with provenance tracing
// =============================================================

struct ConfigVarContext {
  explicit_vars: Map<String,String>
  env_vars: Map<String,String>
}

struct ConfigVarResolver {
  raw: Map<String,String>
  raw_origins: Map<String,String>
  ctx: ConfigVarContext
  resolved: Map<String,TracedValue>
  stack: List<String>
}

state TemplatePart {
  Literal
  Var
}

struct ExpandedToml {
  value: String
  sources: Map<String,List<SourceAtom>>
}

struct TracedValue {
  value: String
  sources: List<SourceAtom>
}

state SourceAtom {
  File
  Explicit
  Env
  Default
}

// =============================================================
// WindowConfig — window configuration
// =============================================================

struct WindowDefaults {
  evict_interval: HumanDuration
  max_window_bytes: ByteSize
  max_total_bytes: ByteSize
  evict_policy: EvictPolicy
  watermark: HumanDuration
  allowed_lateness: HumanDuration
  late_policy: LatePolicy
}

struct WindowOverride {
  mode: String
  partition_key: String?
  max_window_bytes: ByteSize?
  over_cap: HumanDuration
  evict_policy: EvictPolicy?
  watermark: HumanDuration?
  allowed_lateness: HumanDuration?
  late_policy: LatePolicy?
  table: String?
}

struct WindowConfig {
  name: String
  mode: DistMode
  max_window_bytes: ByteSize
  over_cap: HumanDuration
  evict_policy: EvictPolicy
  watermark: HumanDuration
  allowed_lateness: HumanDuration
  late_policy: LatePolicy
  table: String?
}

state DistMode {
  Local
  Replicated
  Partitioned
}

state EvictPolicy {
  TimeFirst
  Lru
}

state LatePolicy {
  Drop
  Revise
  SideOutput
}

// =============================================================
// SinkConfig — sink routing and connector configuration
// =============================================================

struct SinkConfigBundle {
  connectors: Map<String,ConnectorDefRaw>
  defaults: DefaultsBody
  business: List<FlexGroup>
  infra_default: FixedGroup?
  infra_error: FixedGroup?
  infra_monitor: FixedGroup?
}

struct ConnectorDefRaw {
  id: String
  kind: String
  allow_override: List<String>
  params: String?
}

struct ConnectorTomlFile {
  connectors: List<ConnectorDefRaw>
}

struct DefaultsBody {
  tags: List<String>
  expect: GroupExpectSpec?
}

struct FixedGroup {
  name: String
  expect: GroupExpectSpec?
  wf_meta_disable: List<String>
  sinks: List<ResolvedRouteSink>
  parallel: Int
}

struct FlexGroup {
  name: String
  parallel: Int
  windows: WildArray
  tags: List<String>
  wf_meta_disable: List<String>
  expect: GroupExpectSpec?
  sinks: List<ResolvedRouteSink>
}

struct ResolvedRouteSink {
  spec: String
  fields: List<String>?
}

struct RouteFile {
  version: String?
  sink_group: RouteGroup
}

struct RouteGroup {
  name: String
  parallel: Int?
  windows: StringOrArray?
  tags: List<String>?
  wf_meta_disable: List<String>
  expect: GroupExpectSpec?
  sinks: List<RouteSink>
}

struct RouteSink {
  connect: String
  name: String?
  fields: StringOrArray?
  params: Map<String,String>
  tags: List<String>?
  expect: SinkExpectOverride?
}

struct StringOrArray {
}

struct WildArray {
  patterns: List<String>
}

struct GroupExpectSpec {
  required: Bool
}

struct SinkExpectOverride {
  required: Bool
}

// =============================================================
// ConfigIo — base I/O config blocks and shared custom types
// =============================================================

struct SourceConfig {
  name: String?
  source_type: String?
  connect: String?
  enabled: Bool
  params: Map<String,String>
}

struct OutputConfig {
  time_format: String
  time_zone: OutputTimeZone
}

state OutputTimeZone {
  Utc
}

struct LoggingConfig {
  level: String
  modules: Map<String,String>
  file: String?
  format: LogFormat
}

state LogFormat {
  Plain
  Json
}

struct MetricsConfig {
  enabled: Bool
  report_interval: HumanDuration
  prometheus_listen: String
  console_output: Bool
  topn: MetricsTopNConfig
}

struct MetricsTopNConfig {
  enabled: Bool
  max: Int
  queue_capacity: Int
}

struct AdminApiConf {
  enabled: Bool
  bind: String
  request_timeout_ms: Int
  max_body_bytes: Int
  tls: AdminApiTlsConf
  auth: AdminApiAuthConf
}

struct AdminApiTlsConf {
  enabled: Bool
  cert_file: String
  key_file: String
}

struct AdminApiAuthConf {
  mode: String
  token_file: String
}

struct ProjectRemoteConf {
  enabled: Bool
  repo: String
  init_version: String
  models: RepoGroupConf?
  infra: RepoGroupConf?
}

struct RepoGroupConf {
  repo: String
  init_version: String
}

struct PerfConfig {
  stages: List<PerfStage>
}

struct PerfStage {
  name: String
  cut_rules: Bool
  cut_output: Bool
  cut_append: Bool
  cut_recv: Bool
  cut_sink_write: Bool
  rules: String?
}

struct HumanDuration {
}

struct ByteSize {
}

// =============================================================
// ConfigError — config loading and variable resolution errors
// =============================================================

state ConfigReason {
  Load
  Parse
  Validation
  Path
  Sink
  Lang
  Vars
  General
}

state VarsReason {
  Resolve
  Template
  Toml
  General
}
