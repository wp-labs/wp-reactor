// ---------------------------------------------------------------------------
// WP-Reactor layered architecture
// Defines the four canonical layers and their permitted dependency directions.
// ---------------------------------------------------------------------------

layer Interface
layer Application
layer DataFusion
layer Infrastructure

dependency_rule LayerDirection {
  Interface -> Application
  Application -> DataFusion
  Infrastructure -> DataFusion
  DataFusion -> none_external
}

// -- Cross-domain dependencies -----------------------------------------------

dependency_rule CrossDomainDeps {
  // CLI entry resolves config
  Runtime.CliEntry -> Config.ConfigLoader
  Runtime.CliEntry -> Config.SinkConfig

  // Reactor lifecycle orchestrates engine, language, config
  Runtime.ReactorLifecycle -> Config.ConfigLoader
  Runtime.ReactorLifecycle -> Engine.WindowManager
  Runtime.ReactorLifecycle -> Engine.MatchEngine
  Runtime.ReactorLifecycle -> Engine.StatsEngine
  Runtime.ReactorLifecycle -> Lang.LangCompile
  Runtime.ReactorLifecycle -> Lang.LangChecker

  // Hot reload compiles rules and replans
  Runtime.HotReload -> Lang.LangCompile
  Runtime.HotReload -> Config.ConfigChange

  // Engine tasks drive the engine through config-declared windows
  Runtime.EngineTask -> Engine.WindowManager
  Runtime.EngineTask -> Engine.MatchEngine
  Runtime.EngineTask -> Engine.StatsEngine
  Runtime.EngineTask -> Engine.RuleFanout
  Runtime.EngineTask -> Engine.SpillStore

  // Receiver feeds events into the window manager
  Runtime.Receiver -> Engine.WindowManager

  // Config loader validates rules/schemas through the language
  Config.ConfigLoader -> Lang.LangChecker

  // Sink factory builds sinks from config
  Runtime.SinkFactory -> Config.SinkConfig

  // Alert dispatch forwards records to the sink dispatcher
  Runtime.AlertDispatch -> Engine.SinkDispatch

  // External runtime adapters bridge external calls
  Runtime.ExternalRuntime -> Engine.ExternalCall
}
