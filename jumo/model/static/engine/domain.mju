  wfx_id: List<String>
  rule_name: ColumnData
  score: List<Float>
  entity_type: ColumnData
  entity_id: List<String>
  origin: ColumnData
  close_reason: ColumnData
  fired_at: List<String>
  emit_time: ColumnData
  summary: ColumnData
  yield_cols: List<YieldCol>
}

struct AlertColumnBuilder {
  target: String
  len: Int
  wfx_id: List<String>
  rule_name: ColumnData?
  score: List<Float>
  entity_type: ColumnData?
  entity_id: List<String>
  origin: ColumnData?
  close_reason: ColumnData?
  fired_at: List<String>
  emit_time: ColumnData?
  summary: ColumnData?
  yield_cols: List<YieldCol>
  layout_cache: String
  scratch: String
  staged: String
}

struct YieldCol {
