}

state ColumnData {
  Const
  Rows
}

// =============================================================
// SinkDispatch — sink routing and dispatch
// =============================================================

struct SinkDispatcher {
  routes: List<SinkRouteBinding>
  default_sinks: List<SinkRuntime>
  error_sinks: List<SinkRuntime>
  monitor_sinks: List<SinkRuntime>
  all_sinks: List<SinkRuntime>
}

struct SinkRuntime {
  name: String
  spec: String
  handle: String
  tags: List<String>
  output_fields: List<String>?
  wf_meta_disable: List<String>
  wf_meta_disable_matcher: WfMetaDisableMatcher
  parallel: Int
  payload_blind: Bool
}

struct SinkRouteBinding {
  matcher: WildmatchMatcher
  sinks: List<SinkRuntime>
}

struct WfMetaDisableMatcher {
  patterns: List<String>
}

struct WildmatchMatcher {
  patterns: List<String>
}

