// ---------------------------------------------------------------------------
// engine domain — streaming CEP / match engine
// Code: crates/wf-engine + crates/wf-cep（P4 拆分：同步执行核 —— value/rows/
// masks/value_extract/cep/row_views/cidr_cache 等叶模块下沉 wf-cep，wf-engine
// 经 shim 重导出，公开路径不变；本域模块与类型按逻辑归属建模，跨两个 crate）
// Static model: columnar batch processing, NFA-style matching, stats SoA
// accumulation, spill-to-disk, window actor management, alert output, and
// sink dispatch.
// ---------------------------------------------------------------------------

// =============================================================
// ColumnarBatch — columnar batch representation and evaluation
// =============================================================

struct ColumnarBatch {
  batch: String
  projection: List<Int>
  field_map: Map<String,Value>
}

state CVec {
  Int
  Float
  Str
  Bool
  Scalar
}

state CScalar {
  Int
  Float
  Str
  Bool
  Structured
}

state ColKind {
  Int64
  Float64
  Utf8
  Bool
  TimestampNs
  JsonArray
  List
  LargeList
  FixedSizeList
  Null
}

struct ColRef {
  proj: Int
  kind: ColKind
}

state ColumnExpr {
  Lit
  Col
  ListIndex
  Neg
  Not
  And
  Or
  Cmp
  Arith
  CidrMatch
  RegexMatch
  StrFunc
  Fmt
  Strftime
  CountChar
  SplitIndex
  Concat
  InList
  IfThenElse
}

struct GuardMasks {
  event: Map<String,Bool>
  close: Map<String,Bool>
  neg: Map<String,Bool>
}

state StrFuncOp {
  Contains
  StartsWith
  EndsWith
}

struct ColumnarEvent {
  batch: String
  row: Int
  index: String?
  projection: List<Int>?
}

state JoinRow {
  Columnar
  Event
}

// =============================================================
// WindowManager — window buffer, registry, routing, and actor
// =============================================================

struct Window {
  name: String
  schema: String
  time_col_index: Int?
  over: Duration
  config: WindowConfig
  watermark_nanos: Int
  max_event_time_nanos: Int
  per_source_max_event_time: Map<String,Int>
  current_bytes: Int
  current_alloc_bytes: Int
  total_rows: Int
  batch_count: Int
  generation: Int
  join_enabled: Bool
  materialize_fields: List<String>?
  defer_materialization: Bool
  progress: WindowProgress
}

struct WindowParams {
  name: String
  schema: String
  time_col_index: Int?
  over: Duration
  materialize_fields: List<String>?
  defer_materialization: Bool
}

struct TimedBatch {
  batch: String
  event_time_range: String
  ingested_at: DateTime
  row_count: Int
  byte_size: Int
  alloc_size: Int
  seq: Int
  shard_rows: List<Int>?
  parsed_events: List<Event>?
}

state AppendOutcome {
  Appended
  DroppedLate
}

struct WindowRegistry {
  windows: List<Window>
  provider_windows: List<ProviderWindow>
  subscriptions: List<Subscription>
  notifiers: Map<String,String>
  progress: WindowProgress
  has_cache: Bool
}

struct WindowDef {
  params: WindowParams
  streams: List<String>
  config: WindowConfig
}

struct Router {
  registry: WindowRegistry
  rule_fanout: RuleFanout
  mailboxes: Map<String,WindowMailbox>
  window_seq: Map<String,Int>
}

struct RouteReport {
  delivered: Int
  dropped_late: Int
  skipped_non_local: Int
  per_window: List<WindowRouteOutcome>
}

struct WindowRouteOutcome {
  window_name: String
  rows: Int
  late: Bool
}

struct WindowMailbox {
  tx: String
  budget: Int
  budget_bytes: Int
}

state WindowMsg {
  Append
}

struct IndexedRow {
  ts_nanos: Int?
  batch: String
  row: Int
  index: String
  seq: Int
}

struct JoinIndex {
  key_field: String
  projection: List<String>?
  shards: List<KeyedRows>
  mask: Int
  batch_keys: String
}

struct KeyedRows {
  rows: List<IndexedRow>
  max_ts: Int?
}

struct WindowProgress {
  slots: Int
  row_slots: Int
  pins: Int
}

struct ProviderWindow {
  table: String
  query: String
  refresh: String?
  rows: List<Map<String,Value>>
  join_key: String?
  join_index: Map<String,Value>?
  join_rows: Map<String,Value>?
}

// =============================================================
// WindowEviction — window memory/time eviction policy
// =============================================================

struct Evictor {
  gate: EvictionGate
}

struct EvictionGate {
  max_total_bytes: Int
  current_bytes: Int
  freed: String
  pressure_since: String
  pressure_release_after: String
  force_release: Bool
}

struct EvictReport {
  windows_scanned: Int
  batches_time_evicted: Int
  batches_memory_evicted: Int
  per_window_evicted: List<WindowEvictCount>
  memory_pressure: Bool
}

struct WindowEvictCount {
  window_name: String
  time_evicted: Int
}

// =============================================================
// RuleFanout — window-to-rule event fanout
// =============================================================

struct RuleFanout {
  table: String
  window_sharding: Map<String,WindowShardPartition>
}

struct RulePush {
  window_name: String
  events: List<Event>?
  batch: String?
  materialize_fields: List<String>?
  seq: Int
  shard_rows: List<Int>?
}

// 每窗 fanout 分片键规格（issue #80 rule_shards）——keys + 逐位对齐的派生
// 表达式槽。普通字段/嵌套路径 key 只填 keys；表达式派生 key（如 concat 的
// let）在 key_exprs 位求值后哈希分片，同 key 事件必然落入同一 rule task，
// 窗口跨事件聚合状态不被切碎。
struct ShardKeySpec {
  keys: List<String>
  key_exprs: List<String>
}

// 一窗的 key 分区（键哈希分片或空键行号均匀切分）与片数。
struct WindowShardPartition {
  spec: ShardKeySpec
  shard_count: Int
}

state Subscription {
  Single
  Sharded
  RoundRobin
}

// =============================================================
// MatchEngine — NFA-style CEP state machine
// =============================================================

struct CepStateMachine {
  rule_name: String
  plan: String
  instances: Map<InstanceKey,Instance>
  time_field: String?
  watermark_nanos: Int
  limits: String?
  failed: Bool
  emit_count: Int
  emit_window_start: Int
  shared: SharedLimits?
  raw_conv_mode: Bool
  expiry_heap: List<InstanceKey>
  pending_expiry: List<InstanceKey>
  estimated_memory_bytes: Int
  seq_meta: SeqRuntime?
}

struct InstanceKey {
  scope_key: ScopeKey
  bucket_start: Int?
}

state ScopeKey {
  Empty
  Int
  Float
  Str
  Pair
}

struct Instance {
  machine_id: String
  created_at: Int
  last_event_nanos: Int
  current_step: Int
  event_ok: Bool
  event_emitted: Bool
  step_states: List<StepState>
  completed_steps: List<String>
  close_step_states: List<StepState>
  alias_states: Map<String,AliasState>?
  baselines: Map<String,RollingStats>
  neg_violated: Bool
  satisfied_flags: List<Bool>
  base_cost: Int
}

struct StepState {
  branch_states: List<BranchState>
}

struct BranchState {
  count: Int
  sum: Float
  min: Float
  max: Float
  min_val: Value?
  max_val: Value?
  avg_sum: Float
  avg_count: Int
  distinct_set: List<ValueKey>?
  event_first_time_nanos: Int?
  event_last_time_nanos: Int?
  collected_values: List<Value>?
  field_values: Map<String,Value>?
}

struct StepData {
  satisfied_branch_index: Int
  label: String?
  measure_value: Float
  event_first_time_nanos: Int?
  event_last_time_nanos: Int?
  collected_values: List<Value>
  field_values: Map<String,Value>
}

state StepResult {
  Accumulate
  Advance
  Matched
}

struct StepProgress {
  rule_name: String
  scope_key: List<Value>
  machine_id: String
  step_index: Int
  step_label: String?
  branch_index: Int
  branch_source: String
  threshold_checked_branches: Int
  measure_value: Float
  cmp: String
  threshold: String
  satisfied: Bool
  instances: Int
}

struct StepOutcome {
  result: StepResult
  progress: StepProgress?
}

struct MatchedContext {
  rule_name: String
  scope_key: List<Value>
  step_data: List<StepData>
  bind_data: List<BindData>
  event_time_nanos: Int
  event_first_time_nanos: Int
  event_last_time_nanos: Int
  window_start_time_nanos: Int
  window_end_time_nanos: Int
  machine_id: String
  trigger_event: Event?
}

struct CloseOutput {
  rule_name: String
  scope_key: List<Value>
  close_reason: CloseReason
  event_ok: Bool
  close_ok: Bool
  close_mode: String
  event_emitted: Bool
  event_step_data: List<StepData>
  close_step_data: List<StepData>
  bind_data: List<BindData>
  watermark_nanos: Int
  machine_id: String
  event_first_time_nanos: Int
  event_last_time_nanos: Int
  window_start_time_nanos: Int
  window_end_time_nanos: Int
  last_event_nanos: Int
  row_fields: String?
  row_field_names: String?
}

state CloseReason {
  Timeout
  Flush
  Eos
}

struct BindData {
  alias: String
  count: Int
  field_values: Map<String,Value>
}

struct RollingStats {
  count: Int
  sum: Float
  sum_sq: Float
  method: String
  ewma: Float
  ewma_alpha: Float
