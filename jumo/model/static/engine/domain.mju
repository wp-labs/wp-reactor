}

state Value {
  Number
  Str
  Bool
  Array
  Object
}

state ValueKey {
  Number
  Str
  Bool
  Array
  Object
}

state CoreReason {
  WindowBuild
  RuleExec
  DataFormat
  Sink
  General
}

