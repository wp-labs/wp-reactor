// ---------------------------------------------------------------------------
// config domain — module architecture for fusion configuration management
// Crate: wf-config
// ---------------------------------------------------------------------------

module FusionConfig {
  layer DataFusion
  owns FusionConfig, FusionConfigRaw, FusionMode, WindowFileRaw, RuntimeConfig
  responsible_for "fusion top-level configuration — operation mode, raw and resolved config, runtime tuning, and window file layout"
}

module ConfigLoader {
  layer Application
  owns FusionConfigLoader, RawFusionConfigTree, RawFusionConfigChange, ResolvedConfigVar, ConfigLoadRequest
  responsible_for "fusion config loading — file tree with overlay merge, raw change diffing, and resolved variable collection"
}

module ConfigChange {
  layer Application
  owns FusionChangeKind, FusionReloadDisposition, ClassifiedFusionConfigChange, FusionReloadPlan
  responsible_for "config change detection — classify raw diffs by kind and plan hot-reload vs restart dispositions"
}

module ConfigVars {
  layer DataFusion
  owns ConfigVarContext, ConfigVarResolver, TemplatePart, ExpandedToml, TracedValue, SourceAtom
  responsible_for "config variable expansion — template parsing, variable resolution with source provenance tracing"
}

module WindowConfig {
  layer DataFusion
  owns WindowConfig, WindowDefaults, WindowOverride, DistMode, EvictPolicy, LatePolicy
  responsible_for "window configuration — defaults, per-window overrides, distribution, eviction, and lateness policies"
}

module SinkConfig {
  layer DataFusion
  owns SinkConfigBundle, ConnectorDefRaw, ConnectorTomlFile, DefaultsBody, FixedGroup, FlexGroup, ResolvedRouteSink, RouteFile, RouteGroup, RouteSink, StringOrArray, WildArray, GroupExpectSpec, SinkExpectOverride
  responsible_for "sink configuration — connector defs, route files, group resolution into business/infra bundles, and wildcard routing"
}

module ConfigIo {
  layer DataFusion
  owns SourceConfig, OutputConfig, OutputTimeZone, LoggingConfig, LogFormat, MetricsConfig, MetricsTopNConfig, AdminApiConf, AdminApiTlsConf, AdminApiAuthConf, ProjectRemoteConf, RepoGroupConf, PerfConfig, PerfStage, HumanDuration, ByteSize
  responsible_for "base I/O config blocks — source, output, logging, metrics, admin api, project remote, perf stages, and shared custom types"
}

module ConfigError {
  layer Infrastructure
  owns ConfigReason, VarsReason
  responsible_for "config loading and variable resolution error reasons"
}

dependency_rule ConfigDeps {
  ConfigLoader -> ConfigVars
  ConfigLoader -> FusionConfig
  ConfigChange -> ConfigLoader
  FusionConfig -> WindowConfig
  FusionConfig -> ConfigIo
  FusionConfig -> ConfigVars
  WindowConfig -> ConfigIo
  SinkConfig -> ConfigIo
}
